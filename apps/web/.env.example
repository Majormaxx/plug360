# Which Arc network the app talks to: 5042002 (testnet) or 5042 (mainnet).
NEXT_PUBLIC_CHAIN_ID=5042002
# Optional overrides. Without them the app uses the deployment committed in contracts/deployments.
NEXT_PUBLIC_ESCROW=
NEXT_PUBLIC_DEPLOY_BLOCK=
# Comma-separated RPC URLs, tried in order.
NEXT_PUBLIC_RPC_URLS=
