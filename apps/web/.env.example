# Which Arc network the app talks to: 5042002 (testnet) or 5042 (mainnet).
NEXT_PUBLIC_CHAIN_ID=5042002
# Optional overrides. Without them the app uses the deployment committed in contracts/deployments.
NEXT_PUBLIC_ESCROW=
NEXT_PUBLIC_DEPLOY_BLOCK=
# Comma-separated RPC URLs, tried in order.
NEXT_PUBLIC_RPC_URLS=
# Public URL used for link previews, e.g. https://plug360.vercel.app
NEXT_PUBLIC_SITE_URL=
# Google and email sign-in through Circle user-controlled wallets (see services/wallets/README.md).
# Server only, never NEXT_PUBLIC:
CIRCLE_API_KEY=
NEXT_PUBLIC_CIRCLE_APP_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Set to true after configuring SMTP for one-time codes in Circle's console.
NEXT_PUBLIC_CIRCLE_EMAIL_LOGIN=
# Gas sponsor hot wallet (server only). Holds a few USDC for wallet deployments and gas top-ups.
SPONSOR_PRIVATE_KEY=
SPONSOR_MAX_TOPUP_USDC=
