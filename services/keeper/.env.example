# Copy to .env and fill in. Never commit the real file.

# Required
RPC_URL=https://rpc.testnet.arc.io
CHAIN_ID=5042002
ESCROW_ADDRESS=
# Block the escrow was deployed in; the first run scans from here.
DEPLOY_BLOCK=
# A dedicated hot key holding a little USDC for gas. It needs no owner rights.
KEEPER_PRIVATE_KEY=

# Optional
RPC_FALLBACK_URL=
# Generic JSON POST endpoint for alerts.
ALERT_WEBHOOK_URL=
STATE_FILE=.keeper-state.json
POLL_INTERVAL_SECONDS=60
RETRY_BACKOFF_SECONDS=3600
# Alert when the keeper's gas balance falls below this many USDC.
MIN_GAS_BALANCE_USDC=1
RECEIPT_TIMEOUT_SECONDS=30
DEADLINE_WARNING_SECONDS=86400
